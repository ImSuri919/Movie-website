<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NetflimClub</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#070707;
  color:#fff;
  font-family:Arial,Helvetica,sans-serif;
}

/* HEADER */

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(8,8,8,.96);
  backdrop-filter:blur(12px);
  border-bottom:1px solid #242424;
  padding:15px 5%;
}

.header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  font-size:25px;
  font-weight:900;
  letter-spacing:-1px;
}

.logo span{
  color:#e50914;
}

.search{
  width:300px;
  padding:11px 16px;
  border-radius:30px;
  border:1px solid #333;
  background:#191919;
  color:#fff;
  outline:none;
}

.search:focus{
  border-color:#e50914;
}

nav{
  display:flex;
  gap:25px;
  margin-top:15px;
  overflow-x:auto;
}

nav a{
  color:#aaa;
  text-decoration:none;
  font-size:14px;
  white-space:nowrap;
}

nav a:hover{
  color:#fff;
}

/* HERO */

.hero{
  min-height:520px;
  display:flex;
  align-items:end;
  padding:70px 5%
